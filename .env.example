# ─── Copy to .env (never commit real values) ───────────────────────────
# Public base URL (used for Origin checks and absolute links)
APP_URL="http://localhost:3000"

# PostgreSQL — use a least-privilege role (no SUPERUSER / CREATEDB in prod)
DATABASE_URL="postgresql://tresser_app:change-me@localhost:5432/tresser"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# OAuth (leave empty to disable a provider)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# Magic link (SMTP)
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="Tresser <bonjour@tresser.fr>"

# HMAC key for signed cookies (quiz) and IP hashing — openssl rand -base64 32
APP_HMAC_SECRET=""

# Upstash Redis (rate limiting). Empty → in-memory limiter (dev only, refused in prod)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Hair photo scan (Claude vision). Empty → the scan page offers the 6-question diagnostic instead.
ANTHROPIC_API_KEY=""
# Local tests only: simulated scan result (ignored on real domains)
SCAN_FAKE=""
